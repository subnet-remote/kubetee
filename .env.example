# The public origin of this deployment. Required for correct canonical URLs,
# Open Graph metadata, sitemap.xml, and robots.txt in production.
# Example: NEXT_PUBLIC_SITE_URL=https://kubetee-landing.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `pnpm dashboard:data`, which loads .env.local and .env.
# Do not expose this in the browser.
TAOSTATS_API_KEY=
